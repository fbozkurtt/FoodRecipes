@model AdminHeaderLinksModel

<div class="admin-header-links text-center">
    @if (Model.DisplayAdminLink)
    {
        <a href="@Url.Content("~/Admin")">Administration</a>
    }
    @if (!string.IsNullOrEmpty(Model.EditPageUrl))
    {
        <a href="@Model.EditPageUrl" class="manage-page">Edit page</a>
    }
</div>